<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:orientation="vertical"
    android:paddingTop="@dimen/xxl"
    tools:context=".ui.detail.ExpenseDetailFragment">

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="@dimen/xxxxs" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mtDetails"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="expense_detail"
        app:titleCentered="true" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="@dimen/xxxxs" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="@dimen/xl"
        android:paddingVertical="@dimen/xl"
        android:paddingStart="@dimen/xl"
        android:paddingEnd="@dimen/xs">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="@dimen/none"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/search_bar_bg"
            android:drawableStart="@drawable/ic_search"
            android:hint="@string/search" />

        <ImageView
            android:id="@+id/ivSort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="@dimen/xxs"
            android:src="@drawable/ic_filter" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/xxl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="@dimen/xxl">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mbAdd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:insetTop="@dimen/xxl"
                android:insetBottom="@dimen/xxl"
                android:paddingHorizontal="@dimen/xxxxxl"
                android:clickable="true"
                android:text="@string/add"
                app:backgroundTint="@color/green"
                app:cornerRadius="@dimen/xs" />
        </LinearLayout>

    </LinearLayout>



    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/xxl">



        <!-- TOTAL + CATEGORY SUMMARY SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="@dimen/xxl"
            android:paddingVertical="@dimen/xs">

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pieChart"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pi_chart_size"
                android:layout_marginTop="@dimen/xs"
                android:layout_marginBottom="@dimen/xs" />

            <!-- First row: Total centered -->
            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total"
                android:textStyle="bold"
                android:textSize="@dimen/tx_xl"
                android:layout_marginBottom="@dimen/xs" />

            <!-- Second row: Entertainment & Shops -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="@dimen/xxxs">

                <TextView
                    android:id="@+id/tvEntertainmentTotal"
                    android:layout_width="@dimen/none"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/entertainment_total" />

                <TextView
                    android:id="@+id/tvShopsTotal"
                    android:layout_width="@dimen/none"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/shops_total" />
            </LinearLayout>

            <!-- Third row: Food and Drink & Others -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvFoodTotal"
                    android:layout_width="@dimen/none"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/fnd_total" />

                <TextView
                    android:id="@+id/tvOthersTotal"
                    android:layout_width="@dimen/none"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/other_total" />
            </LinearLayout>

        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExpenses"
            android:layout_width="match_parent"
            android:layout_height="@dimen/none"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="@dimen/xxxs"
            android:paddingBottom="@dimen/recycler_bot_pad" />

    </LinearLayout>

    </ScrollView>


</LinearLayout>
