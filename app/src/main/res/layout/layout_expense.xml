<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvWord"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/xl"
    android:clickable="true"
    android:elevation="@dimen/xs"
    app:cardCornerRadius="@dimen/xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/xs">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvItemName"
                style="@style/TextAppearance.Material3.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:hint="item name"
                android:maxLines="1" />

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/none"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvPrice"
                style="@style/TextAppearance.Material3.TitleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/xxs"
                android:ellipsize="end"
                android:hint="price"
                android:maxLines="1"
                android:minLines="1" />

        </LinearLayout>


        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/xxs"
            android:ellipsize="end"
            android:hint="category"
            android:maxLines="1"
            android:minLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/xxs"
                android:ellipsize="end"
                android:hint="quantity"
                android:maxLines="1"
                android:minLines="1" />

            <View
                android:layout_width="@dimen/none"
                android:layout_height="@dimen/none"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/xxs"
                android:ellipsize="end"
                android:hint="date time"
                android:maxLines="1"
                android:minLines="1" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/xs">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mbUpdate"
                android:layout_width="@dimen/none"
                android:layout_height="@dimen/layout_expense_btn_height"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/xs"
                android:text="@string/update"
                app:backgroundTint="@color/teal"
                app:cornerRadius="@dimen/xs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mbDelete"
                android:layout_width="@dimen/none"
                android:layout_height="@dimen/layout_expense_btn_height"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/xs"
                android:text="@string/delete"
                app:backgroundTint="@color/red"
                app:cornerRadius="@dimen/xs" />

        </LinearLayout>


    </LinearLayout>



</androidx.cardview.widget.CardView>