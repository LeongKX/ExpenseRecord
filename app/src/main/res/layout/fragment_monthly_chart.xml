<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="@dimen/xl"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvMonthTitle"
        android:text="@string/month"
        android:textSize="@dimen/xxxl"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/m"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <com.github.mikephil.charting.charts.PieChart
        android:id="@+id/pieChart"
        android:layout_width="match_parent"
        android:layout_height="@dimen/month_pi_chart_size"
        android:layout_marginBottom="@dimen/xxxl"/>

    <TextView
        android:id="@+id/tvTotal"
        android:text="@string/total"
        android:textStyle="bold"
        android:textSize="@dimen/tx_xl"
        android:layout_marginBottom="@dimen/xxxl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mbViewAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/view_all"
        app:cornerRadius="@dimen/m"
        app:iconGravity="textEnd"
        app:iconPadding="@dimen/xs"/>

</LinearLayout>
